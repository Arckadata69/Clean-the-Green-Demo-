# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get huge
/[Mm]emoryCaptures/

# Assetzv meta data should be committed, but sometimes people ignore them by mistake
# !/[Aa]ssets/**/*.meta

# Uncomment this line if you prefer to ignore the asset database cache
# /[Aa]ssets/AssetDatabaseCache

# Autogenerated Visual Studio / VS Code files
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Big Unity Generated Files
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Apple OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db